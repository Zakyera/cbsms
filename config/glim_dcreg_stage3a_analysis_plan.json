    {"label": "10_to_20", "lower_inclusive": 10.0, "upper_exclusive": 20.0},
    {"label": "20_to_100", "lower_inclusive": 20.0, "upper_exclusive": 100.0},
    {"label": "100_or_more", "lower_inclusive": 100.0, "upper_exclusive": null}
  ],
  "support_strata": [
    {"label": "low", "lower_inclusive": 0.0, "upper_exclusive": 0.25},
